#!/usr/bin/env bash
# jpush "what you changed"
# Adds, commits and pushes everything in the homelab repo in one step.
# Companion to jnote. Set HOMELAB_DIR to use a different repo folder.
set -euo pipefail

REPO="${HOMELAB_DIR:-$HOME/homelab}"

[[ $# -gt 0 ]] || { echo 'Usage: jpush "what you changed"'; exit 1; }

cd "$REPO" 2>/dev/null || { echo "Repo folder not found: $REPO"; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "$REPO is not a git repo."; exit 1; }

if [[ -z "$(git status --porcelain)" ]]; then
  echo "Nothing to commit."
  exit 0
fi

git add -A

# Safety check: never publish keys or secrets by accident.
RISKY="$(git diff --cached --name-only | grep -Ei '(^|/)(id_rsa|id_ed25519|\.env)$|\.(pem|key)$' || true)"
if [[ -n "$RISKY" ]]; then
  echo "Refusing to commit: these files look like keys or secrets:"
  echo "$RISKY"
  git reset -q
  echo "Nothing was committed. Move or ignore those files, then try again."
  exit 1
fi

echo "Files in this commit:"
git status --short

git commit -q -m "$*"

# Pick up anything pushed from elsewhere (another machine, GitHub web upload) first.
git pull --rebase -q || { echo "Pull failed. Run 'git status' to see what needs fixing."; exit 1; }

git push
echo "Pushed: $*"
